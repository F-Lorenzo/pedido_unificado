# Copia este archivo a .env.local (para pruebas locales) y pega tu API key de OpenAI.
# Conseguila en https://platform.openai.com/api-keys (necesita saldo cargado en tu cuenta).
# En Vercel cargala en Settings -> Environment Variables con el nombre OPENAI_API_KEY.
OPENAI_API_KEY=tu_api_key_aca

# Opcional: modelo de OpenAI a usar (por defecto gpt-5.6-luna). Cambialo si OpenAI
# da de baja el modelo y empieza a responder 404 model_not_found.
# OPENAI_MODEL=gpt-5.6-luna
